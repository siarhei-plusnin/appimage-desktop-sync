#!/bin/sh

set -u

ROOT=${APPIMAGE_ROOT:-"$HOME/Applications"}
APPLICATIONS_DIR=${XDG_DATA_HOME:-"$HOME/.local/share"}/applications
PREFIX=appimage-sync-
MARKER=X-AppImage-Sync=true

desktop_exec_path() {
    escaped=$(
        printf '%s' "$1" |
            sed 's/\\/\\\\\\\\/g; s/"/\\\\"/g; s/`/\\\\`/g; s/\$/\\\\$/g'
    )
    printf '"%s"' "$escaped"
}

launcher_name() {
    relative=$1
    filename=${relative##*/}
    stem=${filename%.*}
    slug=$(
        printf '%s' "$stem" |
            LC_ALL=C tr '[:upper:]' '[:lower:]' |
            LC_ALL=C sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//'
    )
    [ -n "$slug" ] || slug=appimage
    hash=$(printf '%s' "$relative" | sha256sum)
    hash=${hash%% *}
    digest=$(printf '%.10s' "$hash")
    printf '%s%s-%s.desktop\n' "$PREFIX" "$slug" "$digest"
}

write_launcher() {
    relative=$1
    appimage=$2
    destination=$APPLICATIONS_DIR/$3
    filename=${relative##*/}
    stem=${filename%.*}
    display=$(printf '%s' "$stem" | sed 's/[-_][-_]*/ /g' | tr '\r\n' '  ')
    executable=$(desktop_exec_path "$appimage") || return 1
    temporary=$(mktemp "$APPLICATIONS_DIR/.appimage-sync.XXXXXX") || return 1

    {
        printf '%s\n' '[Desktop Entry]'
        printf '%s\n' 'Version=1.0'
        printf '%s\n' 'Type=Application'
        printf 'Name=%s\n' "$display"
        printf '%s\n' 'Comment=Portable AppImage'
        printf 'Exec=%s %%U\n' "$executable"
        printf '%s\n' 'Icon=application-x-executable'
        printf '%s\n' 'Terminal=false'
        printf '%s\n' 'Categories=Utility;'
        printf '%s\n' 'StartupNotify=true'
        printf '%s\n' "$MARKER"
    } >"$temporary" || {
        rm -f "$temporary"
        return 1
    }

    chmod 644 "$temporary" || {
        rm -f "$temporary"
        return 1
    }

    if [ -e "$destination" ] || [ -L "$destination" ]; then
        if ! grep -Fqx "$MARKER" "$destination" 2>/dev/null; then
            printf 'Refusing to overwrite unmanaged launcher: %s\n' "$destination" >&2
            rm -f "$temporary"
            return 0
        fi
        if cmp -s "$temporary" "$destination"; then
            rm -f "$temporary"
            return 0
        fi
        action=Updated
    else
        action=Created
    fi

    mv -f "$temporary" "$destination" || {
        rm -f "$temporary"
        return 1
    }
    printf '%s: %s\n' "$action" "$destination"
}

remove_stale_launchers() {
    manifest=$1
    for desktop in "$APPLICATIONS_DIR"/"$PREFIX"*.desktop; do
        if [ ! -e "$desktop" ] && [ ! -L "$desktop" ]; then
            continue
        fi
        if ! grep -Fqx "$MARKER" "$desktop" 2>/dev/null; then
            continue
        fi
        name=${desktop##*/}
        if grep -Fqx "$name" "$manifest"; then
            continue
        fi

        rm -f "$desktop" || return 1
        printf 'Removed: %s\n' "$desktop"
    done
}

synchronize() {
    if [ ! -d "$ROOT" ]; then
        printf 'AppImage directory is unavailable: %s\n' "$ROOT" >&2
        return 1
    fi

    mkdir -p "$APPLICATIONS_DIR" || return 1
    manifest=$(mktemp "$APPLICATIONS_DIR/.appimage-sync-manifest.XXXXXX") || return 1
    if ! find -H "$ROOT" -type f -iname '*.appimage' -print |
        LC_ALL=C sort |
        while IFS= read -r appimage; do
            relative=${appimage#"$ROOT"/}
            name=$(launcher_name "$relative") || exit 1
            printf '%s\n' "$name" >>"$manifest" || exit 1
            write_launcher "$relative" "$appimage" "$name" || exit 1
        done
    then
        rm -f "$manifest"
        return 1
    fi

    remove_stale_launchers "$manifest" || {
        rm -f "$manifest"
        return 1
    }
    rm -f "$manifest"
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$APPLICATIONS_DIR"
    fi
}

watch_events() {
    synchronize || return 1
    pipe_directory=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/appimage-desktop-sync.XXXXXX") || return 1
    event_pipe=$pipe_directory/events
    mkfifo "$event_pipe" || {
        rmdir "$pipe_directory"
        return 1
    }
    watcher_pid=

    cleanup_watch() {
        if [ -n "$watcher_pid" ]; then
            kill "$watcher_pid" 2>/dev/null || :
        fi
        rm -f "$event_pipe"
        rmdir "$pipe_directory" 2>/dev/null || :
    }
    trap 'cleanup_watch' EXIT HUP INT TERM

    LC_ALL=C inotifywait --monitor --recursive --quiet \
        --event attrib \
        --event close_write \
        --event create \
        --event delete \
        --event moved_from \
        --event moved_to \
        --includei '\.appimage$' \
        --format '%e' \
        "$ROOT" >"$event_pipe" &
    watcher_pid=$!

    while IFS= read -r event; do
        synchronize || return 1
    done <"$event_pipe"

    if wait "$watcher_pid"; then
        status=0
    else
        status=$?
    fi
    watcher_pid=
    cleanup_watch
    trap - EXIT HUP INT TERM
    return "$status"
}

usage() {
    printf 'Usage: %s {sync|watch}\n' "$0" >&2
}

command=${1:-}
case $command in
    sync)
        [ "$#" -eq 1 ] || {
            usage
            exit 2
        }
        synchronize
        ;;
    watch)
        [ "$#" -eq 1 ] || {
            usage
            exit 2
        }
        watch_events
        ;;
    *)
        usage
        exit 2
        ;;
esac
